def generate_json():
    result = []

    for idx, item in enumerate(DATA, start=1):
        (
            iso, name, capital, continent, population, area,
            region_group, cities_str, bbox, dish, dish_desc,
            dish_img_hash, leader_title, leader_name, leader_file
        ) = item

        iso_lower = iso.lower()
        flag_url = f"https://flagcdn.com/w320/{iso_lower}.png"
        contour_url = f"https://raw.githubusercontent.com/djaiss/mapsicon/master/all/{iso_lower}/vector.svg"
        dish_img_url = f"https://images.unsplash.com/photo-{dish_img_hash}?auto=format&fit=crop&w=600&q=80"
        leader_img_url = f"https://commons.wikimedia.org/wiki/Special:FilePath/{leader_file}?width=400"

        major_cities = [c.strip() for c in cities_str.split(",") if c.strip()]
        macro_region = REGION_NAMES.get(region_group, "Остальной мир")

        country_obj = {
            "id": idx,
            "name": name,
            "capital": capital,
            "continent": continent,
            "flag": flag_url,
            "population": population,
            "region": macro_region,
            "major_cities": major_cities,
            "territory_sq_km": area,
            "popularity": iso in TOP_30_ISO,
            "region_group": region_group,
            "contour_data": contour_url,
            "bbox": {
                "north": bbox[1],
                "south": bbox[0],
                "west": bbox[2],
                "east": bbox[3],
                "min_lat": bbox[0],
                "max_lat": bbox[1],
                "min_lon": bbox[2],
                "max_lon": bbox[3]
            },
            "dish": dish,
            "dish_desc": dish_desc,
            "dish_image": dish_img_url,
            "leader_title": leader_title,
            "leader_name": leader_name,
            "leader_image": leader_img_url
        }
        result.append(country_obj)

    filename = "data.json"
    with open(filename, "w", encoding="utf-8") as f:
        json.dump(result, f, ensure_ascii=False, indent=2)

    print(f"Файл {filename} успешно сгенерирован (записей: {len(result)})")

    # Автоматическое копирование в папку Download на Android
    target_download_path = "/sdcard/Download/data.json"
    try:
        shutil.copy(filename, target_download_path)
        print(f"Файл успешно скопирован в: {target_download_path}")
    except Exception as e:
        print(f"Копирование в {target_download_path} пропущено: {e}")


if __name__ == "__main__":
    generate_json()